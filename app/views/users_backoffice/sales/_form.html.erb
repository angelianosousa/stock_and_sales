<%= form_with(model: [:users_backoffice, sale], local: true) do |form| %>
  <% if sale.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(sale.errors.count, "error") %> prohibited this sale from being saved:</h2>

      <ul>
      <% sale.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class='row'>
    <div class='col-lg'>
      <div class="form-group">
        <%= form.label :client_name, 'Nome do cliente:'%>
        <%= form.text_field :client_name, autofocus: true, class:"form-control" %>
      </div>
    </div>
  </div><br>

  <div class="modal-footer">
    <%= form.submit "Salvar", class:"btn btn-primary btn-round" %>
  </div>
<% end %>
