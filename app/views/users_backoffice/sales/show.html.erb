<%= link_to_go_back %>

<nav class="navbar navbar-dark bg-dark">
  
  <ul class="navbar-nav">
    <li class="nav-item active">
      <div class="navbar-brand"><%= I18n.l(@sale.created_at.to_date) %> | Cliente - <%= @sale.client_name %> </div>
    </li>
  </ul>

  <ul class="navbar-nav">
    <li class="nav-item ">
      <% if @sale.open? %>
        <button type="button" class="btn btn-success btn-round" data-toggle="modal" data-target="#addSalesItems">
          <span class='icon'><i class='fa fa-circle-plus'> Item</i></span>
        </button>

        <%= link_to edit_users_backoffice_sale_path(@sale), class:"btn btn-secondary btn-round py-0" do %>
          <span class='icon'><i class='fa fa-pencil'></i></span>
        <% end %>
      <% end %>

    </li>
  </ul>
</nav>


<% if @sale.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@sale.errors.count, "Erro(s)") %> Impediu da venda ser salva:</h2>

    <div class='alert alert-danger'>
      <ul>
        <% @sale.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<div id='sale_items'>
  <%= render 'sale_items', locals: @sale %>
</div>

<div class='float-left'>
  <p class='font-weight-bold' style='font-size: 15px;'><strong>Valor final:</strong> <%= humanized_money_with_symbol @sale.total_price_cents %></p>
</div>

<% if @sale.open? %>
  <button type="button" class="btn btn-primary btn-round float-right" data-toggle="modal" data-target="#closeSale">
    Fechar venda
  </button>

  <%= render 'users_backoffice/sales/modal/close_sale' %>
  <%= render 'users_backoffice/sales/modal/novo_item' %>
<% else %>
  <div class='float-right'>
    <p class='font-weight-bold' style='font-size: 15px;'>Fechado em: <%= simple_date_format @sale.saled_at %></p>
  </div>
<% end %>

