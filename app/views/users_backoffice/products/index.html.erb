<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Lista de Produtos", users_backoffice_products_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <button type="button" class="btn btn-outline-success btn-round btn-md" data-toggle="modal" data-target="#new<%= params[:controller].slice(17..30) %>Modal">
      <i class="fa fa-plus-square"></i> Produto
    </button>

  </nav>
</div><br>

<%= render 'search_form' %>

<div class='table-responsive'>
  <table class="table table-striped">
    <thead class='thead-dark'>
      <tr>
        <th scope="col">Produto</th>
        <th scope="col">Código</th>
        <th scope="col">Empresa</th>
        <th scope="col">Marca</th>
        <th scope="col">Valor unitário</th>
        <th scope="col">Estoque</th>
        <th scope="col">Margem de segurança</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
      <tr>
        <th scope="row"><%= product.title %></th>
        <td><%= product.product_code %></td>
        <td><%= product.company %></td>
        <td><%= humanized_money_with_symbol product.price_cents %></td>
        <td><%= product.in_stock %></td>
        <td><%= product.safety_margin %></td>
        <td>
          <%= link_to edit_users_backoffice_product_path(product), class:"btn btn-secondary btn-round btn-sm py-0" do %>
            <span class='icon'><i class='fa fa-pencil'></i></span>
          <% end %>

          <%= link_to users_backoffice_product_path(product), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do %>
            <span class='icon'><i class='fa fa-trash'></i></span>
          <% end %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>


<div class="text-center">
  <%= paginate @products %><br>
</div>

<%= render partial: "users_backoffice/modals/new_product", product: @product = Product.new %>
