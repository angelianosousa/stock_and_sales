<h2>Criando conta</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

  <div class="form-group">
    <div class='input-group-prepend'>
      <div class="input-group-text mb-4">
        <span class='icon'><i class='fa fa-envelope'></i></span>
      </div>

      <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control", placeholder:"example@gmail.com" %>
    </div>

  </div>

  <div class="form-group">
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> letras no minimo)</em>
    <% end %><br />

    <div class='input-group-prepend'>
      <div class="input-group-text mb-4">
        <span class='icon'><i class='fa fa-key'></i></span>
      </div>

      <%= f.password_field :password, autocomplete: "new-password", class:"form-control", placeholder:"********" %>
    </div>
  </div>

  <div class="form-group">
    <div class='input-group-prepend'>
      <div class="input-group-text mb-4">
        <span class='icon'><i class='fa fa-key'></i></span>
      </div>

      <%= f.password_field :password_confirmation, autocomplete: "new-password", class:"form-control", placeholder:"********" %>
    </div>
  </div>

  <div class="actions">
    <%= f.submit "Cadastrar", class:"btn btn-primary btn-block btn-round m-auto" %>
  </div>
<% end %>

<%= render "sales_employees/shared/links" %>
