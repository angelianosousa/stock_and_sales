<%= form_with(model: [:users_backoffice, @sale], local: true) do |form| %>
  <div class='row'>
    <div class='col-lg'>
      <div class="field">
        <%= form.label :client_name, 'Nome do cliente:'%>
        <%= form.text_field :client_name, autofocus: true, class:"form-control" %>
      </div>
    </div>
  </div><br>

  <div class="modal-footer">
    <%= form.submit "Salvar", class:"btn btn-primary btn-round" %>
  </div>
<% end %>
