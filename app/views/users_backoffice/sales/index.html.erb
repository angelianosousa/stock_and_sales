<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Pedidos de Venda", users_backoffice_sales_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <%= link_to 'javascript:void(0)', class:"btn btn-outline-success btn-round", data: { toggle: 'modal', target: "#new#{params[:controller].split('/')[1]}Modal", model: 'categories' } do %>
      <i class="fa fa-plus"></i> Venda
    <% end %>

  </nav>
</div><br>

<%= render 'search_form' %>

<div class='card'>
  <div class="card-body">
    <table class="table table-striped table-hover">
      <thead class='thead-dark'>
        <tr>
          <th><%= Sale.human_attribute_name :client_name %></th>
          <th><%= Sale.human_attribute_name :created_at %></th>
          <th><%= Sale.human_attribute_name :total_price_cents %></th>
          <th><%= Sale.human_attribute_name :status %></th>
          <th><%= Sale.human_attribute_name :saled_at %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <th data-th='Client name'><%= sale.client_name %></th>
            <td data-th='Sale created_at'><%= simple_date_format(sale.created_at.to_date) %></td>
            <td data-th='Sale total price'><%= humanized_money_with_symbol sale.total_price_cents %></td>
            <td data-th='Sale status'><%= badge_status(sale) %></td>
            <td data-th='Sale saled at'><%= simple_date_format(sale&.saled_at) %></td>
            <td data-th='actions'>
              <%= link_to users_backoffice_sale_path(sale), class:"btn btn-info btn-round btn-sm py-0" do  %>
              <span class='icon'><i class='fa fa-list-ol'></i></span>
              <% end %>

              <%= link_to edit_users_backoffice_sale_path(sale), class:"btn btn-secondary btn-round btn-sm py-0" do  %>
                <span class='icon'><i class='fa fa-pencil'></i></span>
              <% end if sale.open? %>

              <%= link_to users_backoffice_sale_path(sale), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do  %>
                <span class='icon'><i class='fa fa-trash'></i></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="text-center">
      <%= paginate @sales %><br>
    </div>
  </div>
</div>

<%= render partial: "users_backoffice/modals/new_sale", locals: { sale: @sale = Sale.new } %>
