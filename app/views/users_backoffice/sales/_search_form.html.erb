<nav class="search-form-filter">
  <%= search_form_for @q, url: users_backoffice_sales_path, html: { class: 'form-row my-2 w-100' } do |f| %>

    <div class='form-group col-md'>
      <%= f.label :saled_at_gteq, 'Data do pedido', class: 'label-control' %>

      <div class="input-group-prepend">
        <div class="input-group-text">
          <span class='icon'><i class='fa fa-calendar'></i></span>
        </div>
        <%= f.text_field :saled_at_gteq, 
                          class: 'form-control datepicker',
                          placeholder: 'Data inicio',
                          value: (params[:q][:saled_at_gteq] rescue nil) %>
      </div>
    </div>

    <div class="form-group col-md" style="margin-top: 27px;">
      <div class="input-group-prepend">
        <div class="input-group-text">
          <span class='icon'><i class='fa fa-calendar'></i></span>
        </div>
        <%= f.text_field :saled_at_lteq, 
                          class: 'form-control datepicker',
                          placeholder: 'Data fim',
                          value: (params[:q][:saled_at_lteq] rescue nil) %>
      </div>
    </div>
 
    <div class='form-group col-md'>
      <%= f.label :client_name_cont, 'Cliente', class: 'label-control' %>

      <div class="input-group-prepend">
        <div class="input-group-text">
          <span class='icon'><i class='fa fa-user'></i></span>
        </div>
        <%= f.text_field :client_name_cont, placeholder: 'Ex.: Ana Eduarda...', class: 'form-control', value: (params[:q][:client_name_cont] rescue nil) %>
      </div>
    </div>
  
    <div class='d-flex flex-column mx-3 mt-2'>
      <%= f.submit class: 'btn btn-primary btn-round btn-sm' do %>
        <i class="fa fa-calendar"></i>
      <% end %>
      <%= link_to 'Limpar', users_backoffice_sales_path, class: 'btn btn-secondary btn-round btn-sm' %>
    </div>
      
  <% end %>
</nav>
