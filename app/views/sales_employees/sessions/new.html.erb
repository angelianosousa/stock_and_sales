<h2>Login</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), class: 'form') do |f| %>

  <div class="form-group">

    <div class='input-group-prepend'>
      <div class="input-group-text mb-4">
        <span class='icon'><i class='fa fa-envelope'></i></span>
      </div>

      <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control", placeholder: "example@gmail.com", value: params[:email] %>
    </div>
  </div>

  <div class="form-group">
    
    <div class='input-group-prepend'>
      <div class="input-group-text mb-4">
        <span class='icon'><i class='fa fa-key'></i></span>
      </div>

      <%= f.password_field :password, autocomplete: "current-password", class:"form-control", placeholder: "********" %>
    </div>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-group mb-3">
      <div class='form-check'>
        <%= f.check_box :remember_me, class:"form-check-input", id:"autoSizingCheck" %>
        <%= f.label :remember_me, 'Lembrar de mim', class: 'form-check-label', for: 'autoSizingCheck' %>
      </div>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Entrar", class:"btn btn-primary btn-block btn-round", style:"float:none;margin-left:0;" %>
  </div>
<% end %>

<%= render "sales_employees/shared/links" %>
