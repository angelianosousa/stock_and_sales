<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Lista de Produtos", users_backoffice_products_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <button type="button" class="btn btn-outline-success btn-round btn-md" data-toggle="modal" data-target="#new<%= params[:controller].split('/')[1] %>Modal">
      <i class="fa fa-plus-square"></i> <%= Product.model_name.human %>
    </button>
  </nav>
</div><br>

<%= render 'search_form' %>

<div class='card'>
  <div class="card-body">
    <table class="table table-striped table-hover">
      <thead class='thead-dark'>
        <tr>
          <th><%= Product.human_attribute_name :picture %></th>
          <th><%= Product.human_attribute_name :name %></th>
          <th><%= Product.human_attribute_name :product_code %></th>
          <th><%= Product.human_attribute_name :company %></th>
          <th><%= Product.human_attribute_name :price_cents %></th>
          <th><%= Product.human_attribute_name :stock %></th>
          <th><%= Product.human_attribute_name :safety_margin %></th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= image_tag product.picture.attached? ? product.picture : 'images.jpeg', size: '50x50' %></td>
            <td><%= product.name %></th>
            <td><%= product.product_code %></td>
            <td><%= product.company %></td>
            <td><%= humanized_money_with_symbol product.price_cents %></td>
            <td style="color: <%= product.current_stock > product.safety_margin ? 'green' : 'red' %>"><%= product.current_stock %></td>
            <td><%= product.safety_margin %></td>
            <td>
              <%= link_to edit_users_backoffice_product_path(product), class:"btn btn-secondary btn-round btn-sm py-0" do %>
                <span class='icon'><i class='fa fa-pencil'></i></span>
              <% end %>

              <%= link_to users_backoffice_product_path(product), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do %>
                <span class='icon'><i class='fa fa-trash'></i></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="text-center">
      <%= paginate @products %><br>
    </div>
  </div>
</div>

<%= render partial: "users_backoffice/modals/new_product", product: @product = Product.new %>
