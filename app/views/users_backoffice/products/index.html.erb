<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Lista de Produtos", users_backoffice_products_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <button type="button" class="btn btn-outline-success btn-round btn-md" data-toggle="modal" data-target="#new<%= params[:controller].slice(17..30) %>Modal">
      <i class="fa fa-plus-square"></i> Produto
    </button>

  </nav>
</div><br>

<%= render 'search_form' %>

<div class='container'>

  <div class="row">
    <% @products.each do |product| %>
    
      <div class="col-sm-6 col-md-6 col-lg-6">
        <div class="card text-white bg-dark mb-3" style="max-width: 540px;">

          <div class="card-header bg-primary">
            <div class='d-flex flex-row justify-content-between'>
              <h6 class="card-title">              
                <%= product.title %>
              </h6>

              <div class='actions'>
                <%= link_to '', edit_users_backoffice_product_path(product), class:"btn btn-primary fa fa-edit" %>
                <%= link_to '', users_backoffice_product_path(product), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger fa fa-trash" %>
              </div>
            </div>
          </div>

          <div class="row no-gutters">
            <div class="col-md">
              <%= product.picture.attached? ? 
                image_tag(product.picture, size:"180x248", style:"margin-left:10px;") : 
                image_tag('https://via.placeholder.com/180x248', size:"180x248", style:"margin-left:10px;")%>
            </div>

            <div class="col-md">
              <div class="card-body mx-3">
                <p class="badge badge-warning" style='font-size: 15px;'>        <%= product.product_code %></p>
                <p class="card-text"><strong>Categoria do produto:</strong> <br><%= product.category.title %></p>
                <p class="card-text"><strong>Preço unitário:</strong>           <%= humanized_money_with_symbol(product.price) %></p>
                <p class="card-text"><strong>Marca:</strong>                    <%= product.company %></p>
                <p class="card-text"><strong>Em estoque:</strong>               <%= product.in_stock %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class='table-responsive'>
  <table class="table table-striped">
    <thead>
      <tr>
        <th scope="col">Produto</th>
        <th scope="col">Código</th>
        <th scope="col">Empresa</th>
        <th scope="col">Marca</th>
        <th scope="col">Valor unitário</th>
        <th scope="col">Estoque</th>
        <th scope="col">Margem de segurança</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
      <tr>
        <th scope="row">1</th>
        <td>Mark</td>
        <td>Otto</td>
        <td>@mdo</td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>


<div class="text-center">
  <%= paginate @products %><br>
</div>

<%= render partial: "users_backoffice/modals/new_product", product: @product = Product.new %>
