<%= form_with(model: [:users_backoffice, product], local: true) do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
      <% product.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 col-sm-6 col-lg-6">
      <div class="form-group">
        <%= form.label :'Titulo do produto' %>
        <%= form.text_field :title, class:"form-control" %>
      </div>
    </div>
    <div class="col-md-6 col-sm-6 col-lg-6">
      <div class="form-group">
        <%= form.label :Categoria %>
        <%= form.collection_select :category_id, Category.all, :id, :title, {include_blank: "Selecione uma categoria"}, {class:"form-control"} %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4">
      <div class="form-group">
        <%= form.label :price_cents, 'Preço Unitário (R$)' %>
        <%= form.number_field :price_cents, class:"form-control" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="form-group">
        <%= form.label :in_stock, 'Estoque' %>
        <%= form.number_field :in_stock, class:"form-control" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="form-group">
        <%= form.label :safety_margin, 'Margem de segurança' %>
        <%= form.number_field :safety_margin, class:"form-control" %>
      </div>
    </div>

    <div class="col-md-12">
      <div class="form-group">

        <div class='custom-file'>
          <%= form.file_field :picture, class: "custom-file-input", id:'customFile' %>
          <%= form.label :'Foto do produto', class:"custom-file-label", for:"customFile" %>
        </div>

      </div>
    </div>
  </div>

  <div class="modal-footer">
    <%= form.submit "Salvar", class:"btn btn-primary btn-round" %>
  </div>
<% end %>

<script>
  $(document).ready(function(){
    $("#product_category_id").selectize()[0].selectize;
  });
</script>