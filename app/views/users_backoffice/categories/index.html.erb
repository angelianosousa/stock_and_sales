<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <a class="navbar-brand"><%= link_to "Lista de Categorias", users_backoffice_categories_path, class: 'h3 font-weight-bold' %> </a>

  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarSupportedContent">
    <ul class="navbar-nav mr-auto">
    </ul>
  </div>

  <%= link_to 'javascript:void(0)', class: 'btn btn-outline-success btn-round btn-md', data: { toggle: 'modal', target: "#new#{params[:controller].split('/')[1]}Modal" } do %>
    <i class="fa fa-plus-square"></i> Categoria
  <% end %>
</nav>

<div class='card'>
  <div class="card-body">

    <table class="table table-striped table-hover">
      <thead class='thead-dark'>
        <tr>
          <th><%= Category.human_attribute_name :name %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <th><%= category.name %></th>
            <td>
              <%= link_to edit_users_backoffice_category_path(category), class:"btn btn-secondary btn-round btn-sm py-0" do %>
                <span class='icon'><i class='fa fa-pencil'></i></span>
              <% end %>

              <%= link_to users_backoffice_category_path(category), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do %>
                <span class='icon'><i class='fa fa-trash'></i></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="text-center">
      <%= paginate @categories %>
    </div>
  </div>
</div>

<br>

<%= render partial: "users_backoffice/modals/new_category", locals: { category: @category = Category.new } %>
