<div class="table-responsive mt-4">
  <table class="table table-striped">
    <thead class='thead-dark'>
      <tr>
        <th>Código do Produto</th>
        <th>Marca</th>
        <th>Nome do Produto </th>
        <th>Quantidade</th>
        <th>Valor Unitário </th>
        <th>Subtotal</th>
        <th>Adicionado em</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @sale.sale_items.each do |item| %>
        <tr>
          <td><%= item.product.product_code %></td>
          <td><%= item.product.company %> </td>
          <td><%= item.product.title %></td>
          <td><%= item.sold_amount %></td>
          <td><%= humanized_money_with_symbol item.product.price_cents %></td>
          <td><%= humanized_money_with_symbol item.subtotal_price_cents %></td>
          <td><%= simple_date_format item.created_at %></td>
          <td>
            <% if @sale.open? %>
              <%= link_to users_backoffice_sale_remove_item_path(@sale, item), 
                          class: 'btn btn-danger btn-round btn-sm py-0', 
                          method: :post, data: { confirm: "Tem certeza que quer remover o item #{item.product.title} ?" } do %>
                <span class='icon'><i class='fa fa-circle-xmark'></i></span>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

