<div class="modal fade" id="closeSale" tabindex="-1" role="dialog" aria-labelledby="closeSaleTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="closeSaleTitle">Fechar venda</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <%= form_with url: users_backoffice_sale_close_sale_path(sale_id: @sale.id), class: 'form', local: true do |f| %>
        <div class="modal-body">
          <div class="border border-secondary p-3">
            <h4>Itens</h4>
            
            <% @sale.sale_items.each do |item| %>
              <div class="d-flex flex-row justify-content-between">
                <b><%= item.product.name %></b>
                <p>
                  <%= humanized_money_with_symbol item.product.price_cents %> x
                  <%= item.sold_amount %> = 
                  <%= humanized_money_with_symbol item.subtotal_price_cents%>
                </p>
              </div>
            <% end %>
          </div><br>

          <p class="d-flex flex-row justify-content-between border border-secondary p-3">
            <b><%= Sale.human_attribute_name(:total_price_cents) %>:</b>
            <%= humanized_money_with_symbol(@sale.total_price_cents) %>
          </p>

          <div class='form-group'>
            <%= f.label :payment_method, Sale.human_attribute_name(:payment_method) %>
            <%= f.select :payment_method, options_for_select(sales_payment_method_for_select), {}, { class: 'form-control' } %>
          </div>
        </div>

        <div class="modal-footer">
          <%= f.submit 'Finalizar venda', class: 'btn btn-primary btn-round' %>
        </div>
      <% end %>
    </div>
  </div>
</div>