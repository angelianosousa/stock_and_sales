<div class="modal fade" id="closeSale" tabindex="-1" role="dialog" aria-labelledby="closeSaleTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="closeSaleTitle">Fechar venda</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <%= form_with url: users_backoffice_sale_close_sale_path(sale_id: @sale.id), class: 'form', local: true do |f| %>

          <div class='form-group'>
            <%= f.label :payment_method, 'Método de pagamento' %>
            <%= f.select :payment_method, options_for_select(Sale.payment_methods.keys), {}, { class: 'form-control' } %>
          </div>

          <div class='form-group'>
            <%= f.submit 'Finalizar venda', class: 'btn btn-primary btn-round' %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>