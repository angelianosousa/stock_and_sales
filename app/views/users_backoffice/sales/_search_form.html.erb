
<nav class="search-form-filter">
  <%= search_form_for @q, url: users_backoffice_sales_path, html: { class: 'form-row my-2 w-100' } do |f| %>

    <div class='form-group col-md'>
      <%= f.label :saled_at_eq, 'Data do pedido', class: 'label-control' %>

      <div class="input-group-prepend">
        <div class="input-group-text">
          <span class='icon'><i class='fa fa-calendar'></i></span>
        </div>
        <%= f.text_field :saled_at_eq, 
                          class: 'form-control datepicker',
                          value: (params[:q][:saled_at_eq] rescue nil) %>
      </div>
    </div>
 
    <div class='form-group col-md'>
      <%= f.label :client_name_cont, 'Cliente', class: 'label-control' %>
      <%= f.text_field :client_name_cont, placeholder: 'Ex.: Ana Eduarda...', class: 'form-control', value: (params[:q][:client_name_cont] rescue nil) %>
    </div>
  
    <div class='d-flex flex-column mx-3'>
      <%= f.submit 'Pesquisar', class: 'btn btn-primary btn-round' %>
      <%= link_to 'Limpar', users_backoffice_sales_path, class: 'btn btn-secondary btn-round' %>
    </div>
      
  <% end %>
</nav>
