<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Lista de Pedidos de Venda", users_backoffice_sales_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <%= link_to new_users_backoffice_sale_path, class:"btn btn-outline-success btn-round" do %>
      <i class="fa fa-plus-square"></i> Pedido de venda
    <% end %>

  </nav>
</div><br>

<%= render 'search_form' %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Nome do Cliente</th>
      <th>Criação do pedido</th>
      <th>Valor da venda</th>
      <th>Status</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @sales.each do |sale| %>
      <tr>
        <th><%= sale.client_name %></th>
        <td><%= simple_date_format(sale.created_at.to_date) %></td>
        <td><%= humanized_money_with_symbol sale.total_price_cents %></td>
        <td><%= badge_status(sale) %></td>
        <td>
          <%= link_to users_backoffice_sale_path(sale), class:"btn btn-info btn-round btn-sm py-0" do  %>
           <span class='icon'><i class='fa fa-eye'></i></span>
          <% end %>

          <% if sale.open? %>
            <%= link_to edit_users_backoffice_sale_path(sale), class:"btn btn-primary btn-round btn-sm py-0" do  %>
              <span class='icon'><i class='fa fa-edit'></i></span>
            <% end %>
          <% end %>

          <%= link_to users_backoffice_sale_path(sale), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do  %>
            <span class='icon'><i class='fa fa-trash'></i></span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="text-center">
  <%= paginate @sales %><br>
</div>

<%= render partial: "users_backoffice/modals/new_sale", locals: { sale: @sale = Sale.new } %>

