<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Lista de Categorias", users_backoffice_categories_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <button type="button" class="btn btn-outline-success btn-round btn-md" data-toggle="modal" data-target="#new<%= params[:controller].slice(17..30) %>Modal">
      <i class="fa fa-plus-square"></i> Categoria
    </button>

  </nav>
</div><br>

<table class="table table-striped table-hover table-sm">
  <thead>
    <tr>
      <th>Titulo</th>
      <th>Produtos em estoque</th>
      <th>Produtos vendidos</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <th><%= category.title %></th>
        <td><%= category.products_count %></td>
        <td><%= category.sales_count %></td>
        <td>
          <%= link_to edit_users_backoffice_category_path(category), class:"btn btn-primary btn-round btn-sm py-0" do %>
            <span class='icon'><i class='fa fa-edit'></i></span>
          <% end %>

          <%= link_to users_backoffice_category_path(category), method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do %>
            <span class='icon'><i class='fa fa-trash'></i></span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<div class="text-center">
  <%= paginate @categories %>
</div>

<%= render partial: "users_backoffice/modals/new_category", locals: {category: @category = Category.new } %>
