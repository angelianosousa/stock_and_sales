<div class="container">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand"><%= link_to "Estoques", users_backoffice_stocks_path, class: 'h3 font-weight-bold' %> </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav mr-auto">
      </ul>
    </div>

    <button type="button" class="btn btn-outline-success btn-round btn-md" data-toggle="modal" data-target="#new<%= params[:controller].split('/')[1] %>Modal">
      <i class="fa fa-plus-square"></i> Lançar estoque
    </button>

  </nav>
</div><br>

<%= render 'search_form' %>

<div class='card'>
  <div class="card-body">
    <table class="table table-striped table-hover">
      <thead class='thead-dark'>
        <tr>
          <th><%= Stock.human_attribute_name :move_type %></th>
          <th><%= Stock.human_attribute_name :quantity %></th>
          <th><%= Stock.human_attribute_name :price_cents %></th>
          <th><%= Stock.human_attribute_name :product_id %></th>
          <th><%= Stock.human_attribute_name :created_at %></th>
          <th></th>
        </tr>
      </thead>
      
      <tbody>
        <% @stocks.each do |stock| %>
          <tr>
            <th><%= badge_move_type(stock) %></th>
            <td><%= stock.quantity %></td>
            <td><%= humanized_money_with_symbol stock.price_cents %></td>
            <td><%= stock.product.name %></td>
            <td><%= simple_date_format(stock.created_at.to_date) %></td>
            <td>
              <%= link_to edit_users_backoffice_stock_path(stock), class:"btn btn-secondary btn-round btn-sm py-0" do  %>
                <span class='icon'><i class='fa fa-pencil'></i></span>
              <% end %>

              <%= link_to '#', method: :delete, data: { confirm: 'Are you sure?' }, class:"btn btn-danger btn-round btn-sm py-0" do  %>
                <span class='icon'><i class='fa fa-trash'></i></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="text-center">
      <%= paginate @stocks %><br>
    </div>
  </div>
</div>

<%= render partial: "users_backoffice/modals/new_stock", locals: { sale: @stock = current_company.stocks.build } %>
