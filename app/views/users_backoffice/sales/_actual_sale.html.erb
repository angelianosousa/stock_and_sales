<table class="table table-hover mb-4">
  <thead>
    <tr>
      <th>Itens</th>
    </tr>
  </thead>

  <tbody>
    <% @sale.sale_items.order(created_at: :desc).includes(product: :category).each do |item| %>
      <tr>
        <td class='row m-auto'>
          <div class='col-12 col-md-4 mb-3'>
            <div class='d-flex flex-row align-items-center'>
              <%= link_to users_backoffice_sale_remove_item_path(@sale, item), class: 'btn btn-danger btn-round btn-sm button_remove_item py-0', method: :post, data: { confirm: 'Are you sure ?' } do %>
                <span class='icon'><i class='fa fa-trash'></i></span>
              <% end %>

              <%= image_tag(item.product.picture.attached? ? 
                            item.product.picture : 'https://via.placeholder.com/324x192', size:"324x192", class: 'img-fluid rounded') %>
            </div>
          </div>

          <div class='col-12 col-md'>

            <div class='d-flex flex-row'>
              <p><strong>Codigo:</strong> <%= item.product.product_code %></p>
              <p class='ml-2'><strong>Marca:</strong> <%= item.product.company %></p>
            </div>
            
            <div class='d-flex flex-row'>
              <p><strong>Estoque:</strong> <%= item.product.in_stock %></p>
              <p class='ml-2'><strong>Quantidade escolhida:</strong> <%= item.sold_amount %></p>
            </div>

            <p><strong>Produto:</strong>        <%= item.product.title %></p>
            <p><strong>Valor unitário:</strong> <%= humanized_money_with_symbol item.product.price_cents %></p>


            <p><strong>Subtotal:</strong>      <%= humanized_money_with_symbol item.subtotal_price_cents %></p>
            <p><strong>Adicionado em:</strong> <%= I18n.l item.created_at, format: :short %></p>
          </div>       
        </td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td class='d-flex flex-row justify-content-between'>
        <p><strong>Valor final:</strong> <%= humanized_money_with_symbol @sale.total_price_cents %></p>

        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#closeSale">
          Fechar venda
        </button>

      </td>
    </tr>
  </tfoot>
  
</table>

<%= render 'users_backoffice/sales/modal/close_sale' %>